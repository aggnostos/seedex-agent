# Formatting that editors apply automatically, so it never reaches review.
# The style guide itself lives in the seedex-box repo: docs/STYLE.md.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
max_line_length = 100

[*.md]
# Trailing spaces are a line break in Markdown.
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2
